# Copy this file to .env and fill in real values. .env is gitignored.

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_API_VERSION=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_VERSION=

# Langfuse observability (optional — router runs as a no-op if unset)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=

# Gmail OTP login (used by streamlite_process_ner.py if config/auth_config.json
# is absent). Prefer config/auth_config.json for these instead.
GMAIL_ADDRESS=
GMAIL_PASSWORD=
SMTP_SERVER=
SMTP_PORT=
